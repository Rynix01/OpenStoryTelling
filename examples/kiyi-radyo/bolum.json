  "shots": [
    {
      "board": "dukkanda",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Selim",
          "text": "Ece, dur! O kaseti sakın geri sarma.",
          "emotion": "uyari",
          "gesture": "reach",
          "pause": 0.44
        }
      ]
    },
    {
      "board": "ece",
      "camera": "push",
      "lines": [
        {
          "speaker": "Ece",
          "text": "Baba, üstünde benim adım var. Neden dinlemeyeyim?",
          "emotion": "merak",
          "gesture": "offer"
        }
      ]
    },
    {
      "board": "baba",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Selim",
          "text": "Bir ucunu ben bantladım. Koparsa bir daha bağlayamam.",
          "emotion": "uzgun",
          "gesture": "heart",
          "pause": 0.56
        }
      ]
    },
    {
      "board": "bant",
      "camera": "pull",
      "lines": [
        {
          "speaker": "Ece",
          "text": "Şu köşesine bak. Bu benim doğduğum yıl bile değil.",
          "emotion": "merak",
          "gesture": "point"
        }
      ]
    },
    {
      "board": "dukkanda",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Selim",
          "text": "O etiketi yıllar sonra yazdım kızım.",
          "emotion": "ozur",
          "gesture": "heart"
        }
      ]
    },
    {
      "board": "kizim",
      "camera": "push",
      "lines": [
        {
          "speaker": "Ece",
          "text": "Peki, bir kez dinlesek? Elim düğmenin üstünde durur.",
          "emotion": "fisilti",
          "gesture": "offer",
          "pause": 0.56
        }
      ]
    },
    {
      "board": "dugme",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Selim",
          "text": "Pekâlâ. Sadece biraz kıs sesini.",
          "emotion": "fisilti",
          "gesture": "press",
          "pause": 0.72
        }
      ]
    },
    {
      "board": "kayit",
      "camera": "pull",
      "lines": [
        {
          "speaker": "KucukSelim",
          "text": "Anne, şimdi konuşursam bütün mahalle duyar mı?",
          "emotion": "merak",
          "gesture": "heart"
        }
      ]
    },
    {
      "board": "anne",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Nermin",
          "text": "Keşke duysa! Şimdilik bir tek ben varım dinleyen.",
          "emotion": "neseli",
          "gesture": "offer"
        }
      ]
    },
    {
      "board": "cocuk",
      "camera": "push",
      "lines": [
        {
          "speaker": "KucukSelim",
          "text": "Ya yine takılırsam? Dün adımı bile söyleyemedim.",
          "emotion": "fisilti",
          "gesture": "recoil",
          "pause": 0.5
        }
      ]
    },
    {
      "board": "anne",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Nermin",
          "text": "O zaman ben beklerim. Bizim radyomuzun hiç acelesi yok.",
          "emotion": "fisilti",
          "gesture": "heart",
          "pause": 0.66
        }
      ]
    },
    {
      "board": "kayit",
      "camera": "pull",
      "lines": [
        {
          "speaker": "Nermin",
          "text": "Sen şu kırmızı düğmeye bas. Ben de gözlerimi kapatayım.",
          "emotion": "neseli",
          "gesture": "press"
        }
      ]
    },
    {
      "board": "yayinda",
      "camera": "hold",
      "lines": [
        {
          "speaker": "KucukSelim",
          "text": "İyi akşamlar. Burası Kıyı Radyo.",
          "emotion": "merak",
          "gesture": "heart",
          "pause": 0.46
        }
      ]
    },
    {
      "board": "cocuk",
      "camera": "push",
      "lines": [
        {
          "speaker": "KucukSelim",
          "text": "Bugünkü ilk şarkı, mutfaktan bizi dinleyen anneme gidiyor!",
          "emotion": "heyecan",
          "gesture": "wave",
          "pause": 0.55
        }
      ]
    },
    {
      "board": "anne",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Nermin",
          "text": "Duydum seni Selim! Bak, mutfaktan alkış da geliyor!",
          "emotion": "heyecan",
          "gesture": "clap"
        }
      ]
    },
    {
      "board": "birlikte",
      "camera": "pull",
      "lines": [
        {
          "speaker": "Ece",
          "text": "Konuşan çocuk... Baba, o sen misin?",
          "emotion": "merak",
          "gesture": "point",
          "pause": 0.41
        }
      ]
    },
    {
      "board": "dinlerken",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Selim",
          "text": "Annem mutfağa hiç gitmemişti. Yanımda, şu taburede oturuyordu.",
          "emotion": "uzgun",
          "gesture": "wipe",
          "pause": 0.68
        }
      ]
    },
    {
      "board": "baba",
      "camera": "push",
      "lines": [
        {
          "speaker": "Selim",
          "text": "Kendimi gerçekten radyodaymışım gibi hissedeyim istemiş.",
          "emotion": "uzgun",
          "gesture": "heart"
        }
      ]
    },
    {
      "board": "kizim",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Ece",
          "text": "İstersen burada duralım baba. Kapatayım mı?",
          "emotion": "ozur",
          "gesture": "offer",
          "pause": 0.53
        }
      ]
    },
    {
      "board": "yaninda",
      "camera": "pull",
      "lines": [
        {
          "speaker": "Selim",
          "text": "Hayır, biraz daha kalsın. Gülüşünü unutmuşum.",
          "emotion": "fisilti",
          "gesture": "listen",
          "pause": 0.78
        }
      ]
    },
    {
      "board": "ece",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Ece",
          "text": "Peki öbür yüzüne niye benim adımı yazdın?",
          "emotion": "merak",
          "gesture": "reach"
        }
      ]
    },
    {
      "board": "baba",
      "camera": "push",
      "lines": [
        {
          "speaker": "Selim",
          "text": "Senin ilk gecendi. Hastanede ikimiz de uyuyamamıştık.",
          "emotion": "neseli",
          "gesture": "heart"
        }
      ]
    },
    {
      "board": "yaninda",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Selim",
          "text": "Annem bana cesaret vermişti. Ben de sana bir yayın yaptım.",
          "emotion": "neseli",
          "gesture": "offer"
        }
      ]
    },
    {
      "board": "kizim",
      "camera": "pull",
      "lines": [
        {
          "speaker": "Ece",
          "text": "Ne söyledin bana, hatırlıyor musun?",
          "emotion": "merak",
          "gesture": "listen"
        }
      ]
    },
    {
      "board": "dinlerken",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Selim",
          "text": "İyi akşamlar Ece. Radyomuzun artık iki dinleyicisi var.",
          "emotion": "fisilti",
          "gesture": "heart",
          "pause": 0.8
        }
      ]
    },
    {
      "board": "birlikte",
      "camera": "push",
      "lines": [
        {
          "speaker": "Ece",
          "text": "Yarın bu dükkânı kapatsak da radyoyu açık tutabiliriz.",
          "emotion": "neseli",
          "gesture": "reach"
        }
      ]
    },
    {
      "board": "baba",
      "camera": "hold",
      "lines": [
        {
          "speaker": "Selim",
          "text": "Öyle mi? Peki ilk programı kim sunacak?",
          "emotion": "merak",
          "gesture": "offer"
        }
      ]
    },
    {
      "board": "son",
      "camera": "pull",
      "lines": [
        {
          "speaker": "Ece",
          "text": "İyi akşamlar baba. Bugünkü ilk şarkı sana gidiyor.",
          "emotion": "heyecan",
          "gesture": "heart",
          "pause": 1.05
        }
      ]
    }
  ]
}
